  "negativeControls": {
    "diverged": {
      "baseCase": "reproduced",
      "mutation": {
        "kind": "replace-evidence-payload-and-rebuild-descriptor",
        "memberId": "subject",
        "replacementBase64": "YmV0YQ=="
      },
      "receiptClaimMustRemainFixed": true,
      "evaluationMustRun": true
    },
    "cannotRecompute": {
      "baseCase": "reproduced",
      "unavailableDependencyId": "verification-specification",
      "evaluationMustRun": false
    },
    "projectionContradiction": {
