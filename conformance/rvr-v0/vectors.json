        "members": [
          {
            "id": "subject",
            "status": "PRESENT",
            "mediaType": "application/octet-stream",
            "byteLength": "5",
            "digest": "8ed3f6ad685b959ead7022518e1af76cd816f8e8ec7ccdda1ed4018e8f2223f8"
          }
        ]
      },
      "payloadsBase64": {
        "subject": "YWxwaGE="
      }
    },
    "unverifiableReproduced": {
      "claim": {
        "schema": "rvr.claim.sha256-equals.v0",
        "operation": "SHA256_EQUALS",
        "evidenceMember": "subject",
        "expectedDigest": "8ed3f6ad685b959ead7022518e1af76cd816f8e8ec7ccdda1ed4018e8f2223f8"
      },
      "evidenceSet": {
